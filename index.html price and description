
    <script>
        // --- 1. LANGUAGE SWITCHER ---
        function changeLanguage(lang) {
            document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');

            document.querySelectorAll('[data-en]').forEach(element => {
                if (element.hasAttribute(`data-${lang}`)) {
                    element.textContent = element.getAttribute(`data-${lang}`);
                }
            });

            const searchInput = document.getElementById('searchDestination');
            if (lang === 'hy') searchInput.placeholder = 'Ո՞ւր եք ցանկանում գնալ';
            else if (lang === 'ru') searchInput.placeholder = 'Куда вы хотите поехать?';
            else searchInput.placeholder = 'Where do you want to go?';
        }

        // --- 2. ACTIVATED SEARCH FUNCTION ---
        function searchDestinations() {
            const query = document.getElementById('searchDestination').value.toLowerCase().trim();
            const cards = document.querySelectorAll('.destination-card');
            const noResults = document.getElementById('noResults');
            let matchFound = false;

            cards.forEach(card => {
                const destName = card.getAttribute('data-name');
                if (destName.includes(query) || query === '') {
                    card.style.display = 'block';
                    // Add a subtle animation when appearing
                    card.style.animation = 'fadeInUp 0.5s ease forwards';
                    matchFound = true;
                } else {
                    card.style.display = 'none';
                }
            });

            if (!matchFound && query !== '') {
                noResults.style.display = 'block';
            } else {
                noResults.style.display = 'none';
            }

            // Smooth scroll to destinations
            document.getElementById('destinations').scrollIntoView({ behavior: 'smooth' });
        }

        function resetSearch() {
            document.getElementById('searchDestination').value = '';
            const cards = document.querySelectorAll('.destination-card');
            cards.forEach(card => {
                card.style.display = 'block';
                card.style.animation = 'fadeInUp 0.5s ease forwards';
            });
            document.getElementById('noResults').style.display = 'none';
        }

        // --- 3. ACTIVATED BOOKING MODAL ---
        function openBookingModal(destination) {
            const modal = document.getElementById('bookingModal');
            const destInput = document.getElementById('modalDestination');
            
            destInput.value = destination;
            modal.classList.add('active');
            document.body.style.overflow = 'hidden'; // Prevent background scrolling
        }

        function closeBookingModal() {
            const modal = document.getElementById('bookingModal');
            modal.classList.remove('active');
            document.body.style.overflow = 'auto'; // Restore scrolling
        }

        // Close modal if clicking outside the content box
        document.getElementById('bookingModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeBookingModal();
            }
        });

        // --- 4. FORM SUBMISSION SIMULATION ---
        function submitBooking(event) {
            event.preventDefault();
            const btn = event.target.querySelector('.modal-submit-btn');
            const originalText = btn.innerHTML;
            
            // Show loading state
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
            btn.disabled = true;
            btn.style.opacity = '0.8';

            // Simulate API call / email sending (1.5 seconds)
            setTimeout(() => {
                // Success feedback
                btn.innerHTML = '<i class="fas fa-check"></i> Request Sent!';
                btn.style.background = '#00b894'; // Success green
                
                setTimeout(() => {
                    alert('Thank you! Your booking request has been received. Our travel experts will contact you within 24 hours.');
                    closeBookingModal();
                    event.target.reset(); // Clear form
                    
                    // Reset button state
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                    btn.style.opacity = '1';
                    btn.style.background = ''; // Revert to CSS gradient
                }, 800);
            }, 1500);
        }

        // --- 5. SMOOTH SCROLL FOR NAV LINKS ---
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

        // --- 6. NAVBAR SCROLL EFFECT ---
        window.addEventListener('scroll', () => {
            const nav = document.querySelector('nav');
            if (window.scrollY > 50) {
                nav.style.boxShadow = '0 5px 20px rgba(255, 107, 107, 0.15)';
            } else {
                nav.style.boxShadow = 'none';
            }
        });
    </script>
